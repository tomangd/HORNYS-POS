|0);set("dashPanierMoyen",dashboardMonnaie(dash.panierMoyen));set("dashMeilleurVendeur",dash.meilleurVendeur||"-");set("dashMeilleurEmploye",dash.meilleurEmploye||"-");set("dashArticleTop",dash.articleTop&&dash.articleTop!=="-"?`${dash.articleTop} (${dash.articleTopQuantite||0})`:"-");set("dashSalaires",dashboardMonnaie(dash.salaires));set("dashFactures",dashboardMonnaie(dash.factures));set("dashAutresCharges",dashboardMonnaie(dash.autresCharges));set("dashChargesTotal",dashboardMonnaie(dash.chargesTotal));set("dashResultatNet",dashboardMonnaie(dash.resultatNet));set("dashMargeNette",`${Number(dash.margeNette||0).toFixed(1)} %`);set("dashStockCritique",dash.stockCritique||0);set("dashPeriodLabel",dash.periodStart&&dash.periodEnd?`${dash.periodStart} → ${dash.periodEnd}`:"Toutes les périodes");
    const sc=document.getElementById("dashStockContainer");if(sc)sc.innerHTML=`<table class="data-table"><thead><tr><th>Article</th><th>Stock</th><th>Prix</th></tr></thead><tbody>${articlesData.map(a=>`<tr><td>${escapeDashboardHtml(a.nom)}</td><td>${Number(a.stock)||0}</td><td>${dashboardMonnaie(a.prix)}</td></tr>`).join("")}</tbody></table>`;
    const cc=document.getElementById("dashChargesContainer"),charges=Array.isArray(dash.charges)?dash.charges:[];if(cc)cc.innerHTML=charges.length?`<table class="data-table"><thead><tr><th>Semaine</th><th>Type</th><th>Libellé</th><th>Employé</th><th>Montant</th><th></th></tr></thead><tbody>${charges.map(c=>`<tr><td>${escapeDashboardHtml(c.semaineDebut||"-")}</td><td>${escapeDashboardHtml(c.type)}</td><td>${escapeDashboardHtml(c.libelle)}</td><td>${escapeDashboardHtml(c.employe||"-")}</td><td>${dashboardMonnaie(c.montant)}</td><td><button class="btn-select" type="button" onclick="supprimerChargeDashboard('${escapeDashboardHtml(c.id)}')">Supprimer</button></td></tr>`).join("")}</tbody></table>`:'<div style="padding:12px;color:#9ca3af">Aucune charge enregistrée pour cette période.</div>';
    const wc=document.getElementById("dashWeeklyContainer"),weekly=Array.isArray(dash.weekly)?dash.weekly:[];if(wc)wc.innerHTML=weekly.length?`<table class="data-table"><thead><tr><th>Semaine</th><th>CA</th><th>Ventes</th><th>Charges</th><th>Résultat</th></tr></thead><tbody>${weekly.slice(-12).reverse().map(w=>`<tr><td>${escapeDashboardHtml(w.semaineDebut)}</td><td>${dashboardMonnaie(w.chiffreAffaires)}</td><td>${w.ventes}</td><td>${dashboardMonnaie(w.charges)}</td><td>${dashboardMonnaie(w.resultat)}</td></tr>`).join("")}</tbody></table>`:'<div style="padding:12px;color:#9ca3af">Aucune donnée hebdomadaire.</div>';
    const vc=document.getElementById("dashVentesContainer");if(!vc)return;if(!ventes||!ventes.length){vc.innerHTML='<div style="padding:12px;color:#9ca3af">Aucune vente enregistrée sur cette période.</div>';return;}vc.innerHTML='<table class="data-table"><thead><tr><th>ID</th><th>Date</th><th>Vendeur</th><th>Paiement</th><th>Total</th><th>Statut</th></tr></thead><tbody></tbody></table>';const tb=vc.querySelector("tbody");ventes.slice().reverse().forEach(v=>{const tr=document.createElement("tr");[v.id,v.date||"--",v.vendeur||"--",v.paiement||"--",dashboardMonnaie(v.montantFinal),v.statut||"--"].forEach(x=>{const td=document.createElement("td");td.textContent=x;tr.appendChild(td);});tb.appendChild(tr);});
  }
  function chargerStatistiquesDashboard(period="week",afficherChargement=true){if(afficherChargement)afficherChargementAction("Chargement des statistiques...");google.script.run.withSuccessHandler(stats=>{if(afficherChargement)masquerChargementAction();mettreAJourDashboard(stats,stats?.ventes||ventesData);}).withFailureHandler(error=>{if(afficherChargement)masquerChargementAction();afficherStatus(error?.message||"Erreur statistiques.","error");}).obtenirStatistiquesDashboard(period,vendeurActif||"");}
  function enregistrerChargeDashboard(){const type=document.getElementById("chargeTypeInput")?.value||"AUTRE",libelle=document.getElementById("chargeLabelInput")?.value.trim()||"",montant=Number(document.getElementById("chargeAmountInput")?.value)||0,employe=document.getElementById("chargeEmployeeInput")?.value.trim()||"";if(!libelle)return afficherStatus("Le libellé est obligatoire.","error");if(montant<=0)return afficherStatus("Le montant doit être supérieur à 0.","error");afficherChargementAction("Enregistrement de la charge...");google.script.run.withSuccessHandler(()=>{masquerChargementAction();document.getElementById("chargeLabelInput").value="";document.getElementById("chargeAmountInput").value="";document.getElementById("chargeEmployeeInput").value="";chargerStatistiquesDashboard(document.getElementById("dashboardPeriod")?.value||"week",false);afficherStatus("Charge enregistrée.","success");}).withFailureHandler(e=>{masquerChargementAction();afficherStatus(e?.message||"Erreur charge.","error");}).sauvegarderChargeHebdomadaire({semaineDebut:null,type,libelle,montant,employe},vendeurActif||"");}
  function supprimerChargeDashboard(id){if(!id||!confirm("Supprimer cette charge ?"))return;afficherChargementAction("Suppression de la charge...");google.script.run.withSuccessHandler(()=>{masquerChargementAction();chargerStatistiquesDashboard(document.getElementById("dashboardPeriod")?.value||"week",false);afficherStatus("Charge supprimée.","success");}).withFailureHandler(e=>{masquerChargementAction();afficherStatus(e?.message||"Erreur suppression charge.","error");}).supprimerChargeHebdomadaire(id,vendeurActif||"");}
  function remplirTableauContrats'''

m=re.search(r'  // --- DASHBOARD & CONTRATS UI ---\n  function mettreAJourDashboard.*?\n  function remplirTableauContrats',js,re.S)
if not m: raise SystemExit('client block not found')
js=js[:m.start()]+client+js[m.end():]

ui = r'''      <!-- PAGE 2 : DASHBOARD -->
      <div id="page-dashboard" class="page full-width">
        <div class="section" style="height:100%">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;border-bottom:1px solid #2d313f;padding-bottom:12px;margin-bottom:16px">
            <div><h1 style="margin:0;border:none;padding:0">Tableau de Bord & Statistiques</h1><div id="dashPeriodLabel" style="margin-top:5px;color:#9ca3af;font-size:12px">Semaine en cours</div></div>
            <select id="dashboardPeriod" class="form-control" style="width:210px" onchange="chargerStatistiquesDashboard(this.value)"><option value="week" selected>Semaine en cours</option><option value="previous-week">Semaine précédente</option><option value="4-weeks">4 dernières semaines</option><option value="12-weeks">12 dernières semaines</option><option value="all">Depuis le début</option></select>
          </div>
          <div class="scrollable" style="padding-top:4px">
            <div class="grid-2" style="margin-bottom:16px">
              <div class="dashboard-stat"><div class="dashboard-stat-label">Chiffre d'affaires</div><div id="dashTotalCA" class="dashboard-stat-value">0.00€</div></div>
              <div class="dashboard-stat"><div class="dashboard-stat-label">Résultat net</div><div id="dashResultatNet" class="dashboard-stat-value">0.00€</div></div>
              <div class="dashboard-stat"><div class="dashboard-stat-label">Nombre de ventes</div><div id="dashNbVentes" class="dashboard-stat-value">0</div></div>
              <div class="dashboard-stat"><div class="dashboard-stat-label">Panier moyen</div><div id="dashPanierMoyen" class="dashboard-stat-value">0.00€</div></div>
              <div class="dashboard-stat"><div class="dashboard-stat-label">Marge nette</div><div id="dashMargeNette" class="dashboard-stat-value">0.0 %</div></div>
              <div class="dashboard-stat"><div class="dashboard-stat-label">Charges totales</div><div id="dashChargesTotal" class="dashboard-stat-value">0.00€</div></div>
              <div class="dashboard-stat"><div class="dashboard-stat-label">Salaires</div><div id="dashSalaires" class="dashboard-stat-value">0.00€</div></div>
              <div class="dashboard-stat"><div class="dashboard-stat-label">Factures / achats</div><div id="dashFactures" class="dashboard-stat-value">0.00€</div></div>
              <div class="dashboard-stat"><div class="dashboard-stat-label">Autres charges</div><div id="dashAutresCharges" class="dashboard-stat-value">0.00€</div></div>
              <div class="dashboard-stat"><div class="dashboard-stat-label">Stock critique</div><div id="dashStockCritique" class="dashboard-stat-value">0</div></div>
              <div class="dashboard-stat"><div class="dashboard-stat-label">Meilleur vendeur</div><div id="dashMeilleurVendeur" class="dashboard-stat-value">-</div></div>
              <div class="dashboard-stat"><div class="dashboard-stat-label">Article le plus vendu</div><div id="dashArticleTop" class="dashboard-stat-value">-</div></div>
            </div>
            <h2>Ajouter une charge hebdomadaire</h2>
            <div style="display:grid;grid-template-columns:1fr 1.5fr 1fr 1fr auto;gap:8px;align-items:end;margin-bottom:20px">
              <div class="form-group" style="margin:0"><label>Type</label><select id="chargeTypeInput" class="form-control"><option value="SALAIRE">Salaire</option><option value="FACTURE">Facture / achat</option><option value="AUTRE">Autre charge</option></select></div>
              <div class="form-group" style="margin:0"><label>Libellé</label><input id="chargeLabelInput" class="form-control" type="text" placeholder="Ex. Salaire Tom / Facture fournisseur"></div>
              <div class="form-group" style="margin:0"><label>Montant</label><input id="chargeAmountInput" class="form-control" type="number" min="0.01" step="0.01" placeholder="0.00"></div>
              <div class="form-group" style="margin:0"><label>Employé (optionnel)</label><input id="chargeEmployeeInput" class="form-control" type="text" placeholder="Nom / matricule"></div>
              <button class="btn-action btn-pay" type="button" onclick="enregistrerChargeDashboard()">Ajouter</button>
            </div>
            <h2>Évolution hebdomadaire</h2><div id="dashWeeklyContainer" style="margin-bottom:20px"></div>
            <h2>Charges de la période</h2><div id="dashChargesContainer" style="margin-bottom:20px"></div>
            <h2>État des stocks</h2><div id="dashStockContainer" style="margin-bottom:20px"></div>
            <h2>Historique des ventes</h2><div id="dashVentesContainer"></div>
          </div>
        </div>
      </div>

      <!-- PAGE 3 : CONTRATS -->'''